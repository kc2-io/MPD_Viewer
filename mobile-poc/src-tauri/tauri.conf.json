{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MPD Viewer Mobile POC",
  "version": "0.1.0-alpha.7",
  "identifier": "com.modpackdad.mpdtabber.poc",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MPD Viewer Mobile POC",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": ["mobile-manager"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../src-tauri/icons/icon.png"]
  }
}
