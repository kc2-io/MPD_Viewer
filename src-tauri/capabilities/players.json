{
  "identifier": "players",
  "description": "Player wrappers may only report advisory telemetry for themselves.",
  "webviews": [
    "player-*"
  ],
  "local": false,
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "https://parent.mpdviewer.com/*"
    ]
  },
  "permissions": [
    "report-playback"
  ]
}
