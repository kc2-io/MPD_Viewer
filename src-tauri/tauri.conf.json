{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MPD Viewer",
  "version": "0.1.0-alpha.2",
  "identifier": "com.modpackdad.mpdtabber.poc",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MPD Viewer · Proof of Concept",
        "width": 1200,
        "height": 850,
        "minWidth": 860,
        "minHeight": 650
      }
    ],
    "security": {
      "capabilities": [
        "manager",
        "players"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
